# ==============================================================================
# ATELIER DIGITAL — PLANTILLA DE VARIABLES PARA PRUEBAS FUNCIONALES MÓDULO 03
# Archivo: .env.test.example
# ==============================================================================
# INSTRUCCIONES DE SEGURIDAD:
# 1. Copie este archivo como '.env.test.local' en la raíz del proyecto:
#    copy .env.test.example .env.test.local
# 2. Complete los valores con credenciales de cuentas de prueba existentes.
# 3. NUNCA suba '.env.test.local' a Git ni comparta contraseñas en texto plano.
#    ('.env.test.local' se encuentra ignorado por .gitignore).
# ==============================================================================

# Cuenta de prueba con rol 'designer' o 'admin'
TEST_DESIGNER_EMAIL=
TEST_DESIGNER_PASSWORD=

# Cuenta de prueba con rol 'client' (opcional, para validar restricción RLS)
TEST_CLIENT_EMAIL=
TEST_CLIENT_PASSWORD=

# UUID de Creación de prueba controlada en public.creations
# (Ejemplo del escenario demostración: e1e00000-0000-4000-8000-000000000001)
TEST_CREATION_ID=

