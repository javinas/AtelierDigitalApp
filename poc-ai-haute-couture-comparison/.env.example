# ==============================================================================
# POC COMPARATIVA CONTROLADA: OpenAI vs. Google Gemini (AI Haute Couture)
# Copia este archivo a `.env` dentro de `poc-ai-haute-couture-comparison/.env`
# NUNCA subas `.env` a Git. Este archivo permanece excluido en `.gitignore`.
# ==============================================================================

# --- Credenciales Requeridas (sin valor real en este ejemplo) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Modelos de Generación / Edición Visual (sin fallbacks silenciosos) ---
# Se verifican dinámicamente vía GET /v1/models y GET /v1beta/models antes de ejecutar.
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# --- Modelos de Investigación Técnica con Búsqueda Web ---
OPENAI_RESEARCH_MODEL=gpt-4.1
OPENAI_RESEARCH_FALLBACK_MODELS=gpt-4o,gpt-4.1-mini

GEMINI_RESEARCH_MODEL=gemini-3.5-flash
GEMINI_RESEARCH_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-2.5-pro,gemini-2.5-flash

# --- Parámetros de Paridad de Salida ---
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=high
GEMINI_ASPECT_RATIO=2:3
GEMINI_IMAGE_SIZE=1K
REQUEST_TIMEOUT_MS=120000

# --- Tarifas Verificadas Opcionales (USD por 1M tokens / por operación) ---
# Deja vacíos si prefieres registrar únicamente consumo bruto (tokens + imágenes)
# sin calcular estimado financiero automático. Nunca se inventan precios.
OPENAI_RESEARCH_INPUT_USD_PER_1M=
OPENAI_RESEARCH_OUTPUT_USD_PER_1M=
OPENAI_IMAGE_UNIT_USD=
OPENAI_IMAGE_INPUT_USD_PER_1M=
OPENAI_IMAGE_OUTPUT_USD_PER_1M=

GEMINI_RESEARCH_INPUT_USD_PER_1M=
GEMINI_RESEARCH_OUTPUT_USD_PER_1M=
GEMINI_IMAGE_UNIT_USD=
GEMINI_IMAGE_INPUT_USD_PER_1M=
GEMINI_IMAGE_OUTPUT_USD_PER_1M=
